{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "data:install": "python3 -m venv ../.venv-datatest && ../.venv-datatest/bin/pip install -r ../data-service/requirements.txt",
    "data:serve": "cd .. && PYTHONPATH=data-service .venv-datatest/bin/python -m uvicorn app.main:app --port 8787",
    "data:test": "cd .. && .venv-datatest/bin/python data-service/tests/verify.py"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "fflate": "^0.8.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "xlsx": "^0.18.5"
  }
}
