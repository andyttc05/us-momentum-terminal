# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
# Real environment files are never committed. `.env.example` holds placeholders
# only and is intentionally tracked.
.env
.env.*
!.env.example

# Private keys, certificates and credential stores
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
service-account*.json
secrets/
.netrc
.ghp_token

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.venv-datatest/
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytype/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.vite/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Local runtime data (regenerated by the data service)
# ---------------------------------------------------------------------------
# Market-data cache. Contains provider-retrieved price history and is
# recreated on demand, so it must not be committed.
data-service/cache/
*.log
logs/
tmp/
temp/

# Local database files
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlitedb

# Temporary exports, debug output and local test output
exports/
qa-output/
debug/
.qa/
*.tmp
*.bak
*.orig
*.zip
*.tar
*.tar.gz
screenshots/tmp/

# Build output (regenerated by `npm run build`)
dist/
build/

# ---------------------------------------------------------------------------
