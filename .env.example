# Market data API keys for the US Momentum Terminal data service.
# Copy to .env (git-ignored). Only the keys you have are required.
#
# Verified backup (Twelve Data free plan: 8 req/min, 800/day)
TWELVEDATA_API_KEY=
#
# Optional additional sources. Leave blank to keep them disabled.
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Optional overrides
# DATA_PROVIDER_CHAIN=yahoo,twelvedata,fmp
# DATA_HISTORY_YEARS=10
# DATA_FUNDAMENTAL_FALLBACK_MAX_AGE=2592000
# DATA_SERVICE_PORT=8787
# DATA_WARM_TIMEOUT=180
